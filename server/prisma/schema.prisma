generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  OWNER // full access, including managing other admin accounts
  MANAGER // vehicles, hire vehicles, site content, requests — not user management
  VIEWER // read-only on submitted requests
}

model AdminUser {
  id                  String                    @id @default(cuid())
  name                String
  email               String                    @unique
  passwordHash        String
  role                AdminRole                 @default(MANAGER)
  isActive            Boolean                   @default(true)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  reviewedPayments    PaymentSubmission[]
  passwordResetTokens AdminPasswordResetToken[]

  /// Consecutive wrong-password attempts; reset to 0 on a successful sign-in.
  /// At MAX_FAILED_ATTEMPTS the account is locked until `lockedUntil`
  /// (see server/src/security/lockout.ts).
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  /// Sessions issued before this moment are rejected, so changing or
  /// resetting the password signs out every other device.
  passwordChangedAt DateTime?

  /// Two-factor sign-in (authenticator app, RFC 6238 TOTP).
  /// `totpSecret` is stored as soon as setup starts but only counts once
  /// `totpEnabled` is true (after the admin proves the app works by typing a code).
  totpSecret         String?
  totpEnabled        Boolean  @default(false)
  /// SHA-256 hashes of the one-time recovery codes shown once at setup.
  recoveryCodeHashes String[] @default([])
}

/// Mirrors PasswordResetToken (customer side) for admin accounts — kept as
/// a separate model rather than a shared/nullable-FK table since admin and
/// customer auth are already fully separate stacks (own cookies, own
/// guards, own controllers) throughout this codebase.
model AdminPasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  adminId   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
}

/// Customer identity is separate from staff administration. Names are
/// intentionally not unique; email is the login credential for this domain.
model CustomerUser {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Same lockout counters as AdminUser.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  /// Same purpose as AdminUser.passwordChangedAt.
  passwordChangedAt DateTime?

  /// Set once the customer proves they own the email (link in the welcome
  /// email, or an identity provider that already verified it, e.g. Google).
  emailVerifiedAt DateTime?

  /// Provider user ids for "Continue with Google / Facebook". Unique so one
  /// provider account can only ever belong to one customer.
  googleId   String? @unique
  facebookId String? @unique

  emailVerificationTokens EmailVerificationToken[]

  account             Account?
  auditLogs           AuditLog[]
  paymentSubmissions  PaymentSubmission[]
  cases               CustomerCase[]
  inquiries           Inquiry[]
  importRequests      ImportRequest[]
  clearingRequests    ClearingRequest[]
  hireRequests        HireRequest[]
  contactMessages     ContactMessage[]
  passwordResetTokens PasswordResetToken[]
  savedVehicles       SavedVehicle[]
  reviews             Review[]
  messages            CustomerMessage[]
}

/// A password-reset link is only ever useful to the customer it was issued
/// for and expires quickly, so — unlike the app's other CustomerUser
/// relations, which use onDelete: Restrict to preserve an audit trail —
/// these rows are deleted along with the customer rather than blocking it.
model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @db.Uuid
  /// SHA-256 of the token actually emailed to the customer — never store
  /// the raw token, same reasoning as hashing passwords themselves.
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  customer CustomerUser @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

/// One-time link sent to a new customer to confirm their email address.
/// Only the SHA-256 of the token is stored, like password reset tokens.
model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  customer CustomerUser @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

enum CustomerCaseStatus {
  REQUESTED
  IN_PROGRESS
  READY
  COMPLETED
  CANCELLED
}

model CustomerCase {
  id            String             @id @default(uuid()) @db.Uuid
  customerId    String             @db.Uuid
  vehicleId     String?
  hireVehicleId String?
  title         String
  status        CustomerCaseStatus @default(REQUESTED)
  details       String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  customer    CustomerUser         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle     Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  hireVehicle HireVehicle?         @relation(fields: [hireVehicleId], references: [id], onDelete: Restrict)
  updates     CustomerCaseUpdate[]

  @@index([customerId, updatedAt])
  @@index([status, updatedAt])
}

model CustomerCaseUpdate {
  id        String             @id @default(uuid()) @db.Uuid
  caseId    String             @db.Uuid
  status    CustomerCaseStatus
  message   String
  createdAt DateTime           @default(now())

  customerCase CustomerCase @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
}

model Account {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @unique @db.Uuid
  currency   String   @default("MWK")
  balance    Decimal  @default(0) @db.Decimal(19, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer           CustomerUser           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  transactions       FinancialTransaction[]
  paymentSubmissions PaymentSubmission[]

  @@index([customerId])
}

enum FinancialTransactionType {
  DEPOSIT
  WITHDRAWAL
}

model FinancialTransaction {
  id          String                   @id @default(uuid()) @db.Uuid
  accountId   String                   @db.Uuid
  type        FinancialTransactionType
  amount      Decimal                  @db.Decimal(19, 2)
  currency    String
  reference   String                   @unique
  description String?
  createdAt   DateTime                 @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([accountId, type, createdAt])
}

enum PaymentSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model PaymentSubmission {
  id                String                  @id @default(uuid()) @db.Uuid
  customerId        String                  @db.Uuid
  accountId         String                  @db.Uuid
  amount            Decimal                 @db.Decimal(19, 2)
  currency          String
  proofUrl          String
  reference         String                  @unique
  note              String?
  status            PaymentSubmissionStatus @default(PENDING)
  reviewNote        String?
  reviewedAt        DateTime?
  reviewedByAdminId String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  customer        CustomerUser @relation(fields: [customerId], references: [id], onDelete: Restrict)
  account         Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  reviewedByAdmin AdminUser?   @relation(fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([accountId, createdAt])
  @@index([status, createdAt])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String
  oldValue    Json?
  newValue    Json?
  createdAt   DateTime @default(now())

  actor CustomerUser? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
}

/// Editable site text — contact details, social links, About page copy —
/// stored as one row per logical section rather than one row per field.
/// A section's shape is defined by frontend/backend TypeScript types, not
/// by the database; the JSON column just needs to fit whatever shape that
/// section currently has. See src/types/siteContent.ts on the frontend for
/// the exact shape of each key.
model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique // "contact" | "social" | "about" | "seo"
  value     Json
  updatedAt DateTime @updatedAt
}

// Vehicles for sale. Images/features kept as string arrays rather than a
// separate VehicleImage table — the brief's suggested entities are a menu,
// not a requirement, and normalizing photos into their own table isn't
// justified until an admin/CMS needs to manage them independently.
model Vehicle {
  id           String   @id @default(cuid())
  slug         String   @unique
  make         String
  model        String
  year         Int
  price        Int
  currency     String   @default("MWK")
  mileageKm    Int
  fuelType     String
  transmission String
  bodyType     String
  engine       String
  driveType    String
  condition    String
  location     String
  status       String   @default("available") // available | reserved | sold
  description  String
  features     String[]
  images       String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inquiries     Inquiry[]
  customerCases CustomerCase[]
  savedBy       SavedVehicle[]
  reviews       Review[]
  viewStats     VehicleViewStat[]
  /// Hidden from the public site when false (a draft or temporarily off the market).
  isPublished   Boolean           @default(true)
  /// Set = archived: hidden everywhere public, kept so it can be restored or duplicated later.
  archivedAt    DateTime?
  /// Pinned first on the homepage carousel and listings.
  isFeatured    Boolean           @default(false)
}

/// A customer's shortlist while browsing — bookmark now, compare/decide
/// later. Cascade on delete in both directions: unlike CustomerCase (an
/// audit-worthy staff record), this is just a convenience list, so nothing
/// should be blocked from being deleted because someone saved it.
model SavedVehicle {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  vehicleId  String
  createdAt  DateTime @default(now())

  customer CustomerUser @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle  Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([customerId, vehicleId])
  @@index([customerId, createdAt])
}

model HireVehicle {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  dailyRate    Int
  weeklyRate   Int?
  currency     String   @default("MWK")
  transmission String
  fuelType     String
  seats        Int
  available    Boolean  @default(true)
  /// Cover photo (always shown first; kept for older data and simple lists).
  image        String
  /// Full gallery including the cover, in display order. Empty for vehicles
  /// created before galleries existed — readers fall back to [image].
  images       String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hireRequests  HireRequest[]
  customerCases CustomerCase[]
  isPublished   Boolean        @default(true)
  archivedAt    DateTime?
}

model Inquiry {
  id               String        @id @default(cuid())
  fullName         String
  phone            String
  email            String
  vehicleId        String?
  vehicle          Vehicle?      @relation(fields: [vehicleId], references: [id])
  message          String?
  /// "new" | "contacted" | "closed" — lets an admin mark that a submission
  /// has been followed up on, so nothing quietly falls through the cracks.
  status           String        @default("new")
  /// Set automatically when submitted by a logged-in customer (never
  /// user-supplied) so it shows up in their account portal — null for
  /// anonymous/visitor submissions, which remain fully supported.
  customerId       String?       @db.Uuid
  customer         CustomerUser? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  /// How the customer asked to be reached: whatsapp | call | email | message (their Lycie profile).
  preferredContact String?

  @@index([customerId, createdAt])
}

model ImportRequest {
  id                     String        @id @default(cuid())
  fullName               String
  phone                  String
  email                  String
  preferredMake          String
  preferredModel         String?
  preferredYear          Int?
  budget                 Int?
  fuelType               String?
  transmission           String?
  vehicleType            String?
  preferredSourceCountry String?
  additionalRequirements String?
  status                 String        @default("new")
  customerId             String?       @db.Uuid
  customer               CustomerUser? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt              DateTime      @default(now())
  /// How the customer asked to be reached: whatsapp | call | email | message (their Lycie profile).
  preferredContact       String?

  @@index([customerId, createdAt])
}

model ClearingRequest {
  id                    String        @id @default(cuid())
  fullName              String
  phone                 String
  email                 String
  vehicleMake           String
  vehicleModel          String?
  year                  Int?
  vin                   String
  currentLocation       String
  arrivalPortOrBorder   String?
  expectedArrivalDate   DateTime?
  availableDocuments    String?
  additionalInformation String?
  status                String        @default("new")
  customerId            String?       @db.Uuid
  customer              CustomerUser? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt             DateTime      @default(now())
  /// How the customer asked to be reached: whatsapp | call | email | message (their Lycie profile).
  preferredContact      String?

  @@index([customerId, createdAt])
}

model HireRequest {
  id                     String        @id @default(cuid())
  fullName               String
  phone                  String
  email                  String
  vehicleId              String
  vehicle                HireVehicle   @relation(fields: [vehicleId], references: [id])
  pickupDate             DateTime
  returnDate             DateTime
  pickupLocation         String
  additionalRequirements String?
  /// Computed server-side at submission time from the vehicle's rates —
  /// never accepted from the client, so a request can't be tampered with
  /// to claim a lower price. See src/hire-requests/hire-pricing.util.ts.
  days                   Int
  totalCost              Int
  currency               String        @default("MWK")
  /// "pending" (just submitted, not yet reviewed) | "confirmed" (a real
  /// booking — this vehicle is committed for these dates) | "cancelled" |
  /// "completed" (vehicle actually confirmed returned by an admin — distinct
  /// from the return date merely passing, which is "overdue" until someone
  /// marks it returned). A request only counts as an actual booking once
  /// confirmed — see HireRequestsService.updateStatus(), which also checks
  /// for overlapping confirmed bookings on the same vehicle before allowing
  /// confirmation.
  status                 String        @default("pending")
  /// Prevents the daily reminder job from re-sending the same "due
  /// tomorrow" / "overdue" email every single day once triggered once.
  dueReminderSentAt      DateTime?
  overdueReminderSentAt  DateTime?
  customerId             String?       @db.Uuid
  customer               CustomerUser? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt              DateTime      @default(now())
  /// How the customer asked to be reached: whatsapp | call | email | message (their Lycie profile).
  preferredContact       String?

  @@index([customerId, createdAt])
}

model ContactMessage {
  id               String        @id @default(cuid())
  fullName         String
  email            String
  phone            String?
  subject          String
  message          String
  status           String        @default("new")
  customerId       String?       @db.Uuid
  customer         CustomerUser? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  /// How the customer asked to be reached: whatsapp | call | email | message (their Lycie profile).
  preferredContact String?

  @@index([customerId, createdAt])
}

/// Site-wide announcements — banners at the top of every page, or popups
/// shown once per browser session. Color is derived from `type` on the
/// frontend (info/warning/success/promo), not stored directly, so the
/// palette stays centralized in one place (src/types/notice.ts) rather than
/// admins picking arbitrary hex values per notice.
model Notice {
  id         String    @id @default(cuid())
  title      String?
  message    String
  type       String    @default("info") // "info" | "warning" | "success" | "promo"
  displayAs  String    @default("banner") // "banner" | "popup"
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
}

// Marketing content — testimonials, FAQ, and the blog — managed the same
// way as Notice/SiteContent (admin dashboard CRUD, public read endpoints).
// These were originally scoped to a separate Strapi CMS, but Strapi 5
// currently fails to boot under Node 20+ (see server/README.md's
// "CMS content" section) — an unresolved upstream bug, not something wrong
// with this app — so they live here instead, in the same database and admin
// dashboard as everything else.
model Testimonial {
  id             String    @id @default(cuid())
  quote          String
  authorName     String
  authorTitle    String?
  authorPhotoUrl String?
  rating         Int       @default(5) // 1-5
  isFeatured     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  isPublished    Boolean   @default(true)
  archivedAt     DateTime?
}

model Faq {
  id          String    @id @default(cuid())
  question    String
  answer      String
  category    String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isPublished Boolean   @default(true)
  archivedAt  DateTime?
}

model BlogPost {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  excerpt        String?
  body           String
  coverImageUrl  String?
  coverAlt       String?
  seoTitle       String?
  seoDescription String?
  /// Null = draft, not shown on the public /blog list or detail page.
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?
}

/// A visitor's or customer's rating + comment, either about a specific
/// vehicle or (vehicleId null) about the company. Nothing is shown publicly
/// until an admin approves it. Sentiment is computed once at submission
/// (see src/insights/sentiment.util.ts — an offline lexicon, no external
/// API) so the admin can spot unhappy customers at a glance without
/// re-analysing text on every page load.
model Review {
  id             String        @id @default(cuid())
  authorName     String
  rating         Int
  comment        String
  vehicleId      String?
  vehicle        Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  /// Set automatically for logged-in customers (never user-supplied).
  customerId     String?       @db.Uuid
  customer       CustomerUser? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// "pending" | "approved" | "rejected"
  status         String        @default("pending")
  /// "positive" | "neutral" | "negative"
  sentiment      String
  /// -1 (very negative) .. 1 (very positive), blending rating and text.
  sentimentScore Float
  keywords       String[]
  createdAt      DateTime      @default(now())

  @@index([status, createdAt])
  @@index([vehicleId, status])
}

/// Anonymous, aggregated-per-day page-view counter for a vehicle. Stores no
/// IP, cookie or user identifier — only "vehicle X was viewed N times on
/// day D" — which is all the demand insights need and keeps this
/// privacy-light by construction.
model VehicleViewStat {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  views     Int      @default(0)

  @@unique([vehicleId, day])
  @@index([day])
}

/// A piece of company knowledge an admin/manager has fed to the Lycie
/// assistant — FAQs, policies, process notes, pricing guidance. Lycie
/// answers from these (plus live inventory and site content) rather than
/// guessing. Searched with Postgres full-text search (see the migration that
/// adds the GIN index), so nothing is sent to an external service to index it.
model KnowledgeEntry {
  id         String             @id @default(cuid())
  title      String
  /// Free-form grouping for the admin list: faq | policy | process | pricing | other
  category   String             @default("faq")
  content    String
  isActive   Boolean            @default(true)
  /// Set when this entry is one section of an uploaded file (see KnowledgeDocument).
  documentId String?
  document   KnowledgeDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([isActive, category])
  @@index([documentId])
}

/// A file an admin uploaded for Lycie to learn from (PDF, Word, text, image…).
/// Its text is split into KnowledgeEntry sections; deleting the document
/// removes them all, pausing it pauses them all.
model KnowledgeDocument {
  id        String   @id @default(cuid())
  fileName  String
  mimeType  String
  sizeBytes Int
  charCount Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  entries KnowledgeEntry[]
}

/// One question/answer exchange with Lycie, kept so admins can see what
/// customers actually ask and where Lycie fell short. Personal details are
/// stripped BEFORE anything is stored (see lycie/pii.util.ts), no user or
/// session identifier is recorded, and rows are purged after a retention
/// period. Learning is deliberately human-in-the-loop: admins turn recurring
/// gaps into knowledge entries; the model is never trained on raw chats.
model LycieChatLog {
  id        String   @id @default(cuid())
  question  String
  answer    String
  /// Which model actually produced the answer (null if none could).
  model     String?
  /// "answered" | "no_info" (Lycie said it lacked the information) |
  /// "unavailable" (every model failed / quota) | "blocked" (over a limit)
  outcome   String
  /// Customer's thumbs up/down, if they gave one.
  helpful   Boolean?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([outcome, createdAt])
}

/// A question or comment a visitor typed into the "Ask us" form on the FAQ
/// page. Personal details are redacted before saving. Questions feed Lycie's
/// FAQ analysis alongside chat questions; comments are read by staff.
model VisitorSubmission {
  id             String   @id @default(cuid())
  kind           String // question | comment
  message        String
  sentiment      String? // comments only: positive | neutral | negative
  sentimentScore Float?
  status         String   @default("new") // new | handled
  createdAt      DateTime @default(now())

  @@index([kind, status, createdAt])
}

/// A draft FAQ entry written by Lycie after noticing a topic asked about
/// repeatedly. Drafts are NEVER shown to customers until an admin publishes
/// them (which creates a normal Faq row).
model FaqSuggestion {
  id             String   @id @default(cuid())
  question       String
  answer         String
  category       String?
  askCount       Int      @default(1)
  samples        String[] // a few (redacted) example questions behind the draft
  /// The company data didn't cover this topic — the answer is a placeholder an admin must complete.
  needsInput     Boolean  @default(false)
  status         String   @default("pending") // pending | published | rejected
  model          String?
  publishedFaqId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, askCount])
}

/// A visitor's "like" on a vehicle, hire vehicle or blog post — no account
/// needed. `visitorId` is a random id the visitor's own browser generated and
/// keeps in localStorage: it lets one browser like something once and undo it,
/// and identifies no one. (It is not a security control — someone determined
/// could mint many ids — so counts are a popularity signal, not a vote.)
model ContentLike {
  id        String   @id @default(cuid())
  kind      String // vehicle | hire | blog
  targetId  String
  visitorId String
  createdAt DateTime @default(now())

  @@unique([kind, targetId, visitorId])
  @@index([kind, targetId])
}

/// A record that staff got in touch about a request (or tried to), so the whole
/// team can see who contacted the customer, how, and when.
model ContactLog {
  id          String   @id @default(cuid())
  requestType String // inquiry | import | clearing | hire | contact
  requestId   String
  method      String // whatsapp | call | email | message
  note        String?
  adminName   String
  createdAt   DateTime @default(now())

  @@index([requestType, requestId])
}

/// A message from staff to a customer, shown inside their Lycie profile
/// (account page). Only customers who submitted while signed in can receive one.
model CustomerMessage {
  id          String       @id @default(cuid())
  customerId  String       @db.Uuid
  customer    CustomerUser @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subject     String
  body        String
  requestType String?
  requestId   String?
  sentByName  String
  readAt      DateTime?
  createdAt   DateTime     @default(now())

  @@index([customerId, createdAt])
}

/// A positive customer comment or review that Lycie spotted and proposes as a
/// homepage testimonial. Quotes are always the customer's own words — never
/// rewritten — and nothing is published until an admin approves it.
model TestimonialIdea {
  id         String   @id @default(cuid())
  source     String // review | comment
  sourceId   String
  quote      String
  authorName String
  rating     Int?
  /// 0-1: how positive and substantial it is (used to rank ideas).
  score      Float
  status     String   @default("pending") // pending | published | dismissed
  createdAt  DateTime @default(now())

  @@unique([source, sourceId])
  @@index([status, score])
}

/// Who changed what in the admin, and when — for accountability when several
/// people manage the site. Records the action and target, never the content
/// that was submitted (which may hold customers' personal details).
model AdminActivity {
  id        String   @id @default(cuid())
  adminId   String
  adminName String
  role      String
  action    String // human-readable, e.g. "Archived 3 vehicles"
  route     String // e.g. "POST /content-admin/:type/bulk"
  targetId  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([adminId, createdAt])
}
