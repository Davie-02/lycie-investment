# Base URL of the Lycie Investment API (see the server/ folder).
# Defaults to http://localhost:3001/api if not set.
VITE_API_BASE_URL=http://localhost:3001/api

# There is no separate frontend config for Strapi: the browser never talks
# to Strapi directly. Marketing content (testimonials, FAQ, blog posts, SEO
# settings) is served through the NestJS API's /cms/* endpoints, which proxy
# Strapi server-side — see server/.env.example for STRAPI_URL/STRAPI_API_TOKEN.
# Vehicles, hire vehicles, site content, and notices are not in Strapi at all;
# they stay in the NestJS/Prisma database as before.
