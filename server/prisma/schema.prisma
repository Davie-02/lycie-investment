generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  OWNER // system administrator: everything, signs in only through the hardened admin portal
  MANAGER // legacy: broad edit access (see server/src/access/modules.ts presets)
  VIEWER // legacy: read-only on operations
  EMPLOYEE // a staff member whose access comes from their department + per-person overrides
}

model AdminUser {
  id                  String                    @id @default(cuid())
  name                String
  email               String                    @unique
  passwordHash        String
  role                AdminRole                 @default(MANAGER)
  isActive            Boolean                   @default(true)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  reviewedPayments    PaymentSubmission[]
  passwordResetTokens AdminPasswordResetToken[]

  /// Consecutive wrong-password attempts; reset to 0 on a successful sign-in.
  /// At MAX_FAILED_ATTEMPTS the account is locked until `lockedUntil`
  /// (see server/src/security/lockout.ts).
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  /// Sessions issued before this moment are rejected, so changing or
  /// resetting the password signs out every other device.
  passwordChangedAt DateTime?

  /// Two-factor sign-in (authenticator app, RFC 6238 TOTP).
  /// `totpSecret` is stored as soon as setup starts but only counts once
  /// `totpEnabled` is true (after the admin proves the app works by typing a code).
  totpSecret         String?
  totpEnabled        Boolean  @default(false)
  /// SHA-256 hashes of the one-time recovery codes shown once at setup.
  recoveryCodeHashes String[] @default([])
  /// The 30-second time step of the last authenticator code accepted, so a
  /// code that was seen (shoulder-surfed, phished) can't be used a second time.
  lastTotpStep       Int?

  /// "Sign out everywhere": sessions issued before this moment are rejected,
  /// without changing the password.
  sessionsRevokedAt DateTime?

  /// Staff profile. `department` picks the default module access (server/src/access/modules.ts).
  department  String?
  jobTitle    String?
  phone       String?
  /// Per-person access overrides set by a system administrator: { moduleKey: "none"|"view"|"edit"|"manage" }.
  permissions Json?

  /// Invited with a one-time password that must be replaced at first sign-in.
  mustChangePassword    Boolean   @default(false)
  tempPasswordExpiresAt DateTime?
  invitedById           String?
  invitedAt             DateTime?

  /// Recently re-confirmed identity (password + code) — required for the most sensitive actions.
  stepUpUntil DateTime?

  leaveRequests LeaveRequest[]
}

/// Mirrors PasswordResetToken (customer side) for admin accounts — kept as
/// a separate model rather than a shared/nullable-FK table since admin and
/// customer auth are already fully separate stacks (own cookies, own
/// guards, own controllers) throughout this codebase.
model AdminPasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  adminId   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
}

/// Customer identity is separate from staff administration. Names are
/// intentionally not unique; email is the login credential for this domain.
model CustomerUser {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Same lockout counters as AdminUser.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  /// Same purpose as AdminUser.passwordChangedAt.
  passwordChangedAt DateTime?

  /// Set once the customer proves they own the email (link in the welcome
  /// email, or an identity provider that already verified it, e.g. Google).
  emailVerifiedAt DateTime?

  /// Same purpose as AdminUser.sessionsRevokedAt.
  sessionsRevokedAt DateTime?

  /// Referral programme: this customer's share code, and who invited them.
  referralCode String? @unique
  referredById String? @db.Uuid
  /// Phone for WhatsApp notifications (optional).
  phone        String?

  /// Provider user ids for "Continue with Google / Facebook". Unique so one
  /// provider account can only ever belong to one customer.
  googleId   String? @unique
  facebookId String? @unique

  emailVerificationTokens EmailVerificationToken[]

  account             Account?
  auditLogs           AuditLog[]
  paymentSubmissions  PaymentSubmission[]
  cases               CustomerCase[]
  inquiries           Inquiry[]
  importRequests      ImportRequest[]
  clearingRequests    ClearingRequest[]
  hireRequests        HireRequest[]
  contactMessages     ContactMessage[]
  passwordResetTokens PasswordResetToken[]
  savedVehicles       SavedVehicle[]
  reviews             Review[]
  messages            CustomerMessage[]
  vehicleAlerts       VehicleAlert[]
  mobilePayments      MobilePayment[]
  referralsMade       Referral[]           @relation("ReferralsMade")
  referredBy          Referral?            @relation("ReferredCustomer")
  purchases           Purchase[]
}

/// A password-reset link is only ever useful to the customer it was issued
/// for and expires quickly, so — unlike the app's other CustomerUser
/// relations, which use onDelete: Restrict to preserve an audit trail —
/// these rows are deleted along with the customer rather than blocking it.
model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @db.Uuid
  /// SHA-256 of the token actually emailed to the customer — never store
  /// the raw token, same reasoning as hashing passwords themselves.
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  customer CustomerUser @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

/// One-time link sent to a new customer to confirm their email address.
/// Only the SHA-256 of the token is stored, like password reset tokens.
model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  customer CustomerUser @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

enum CustomerCaseStatus {
  REQUESTED
  IN_PROGRESS
  READY
  COMPLETED
  CANCELLED
}

model CustomerCase {
  id            String             @id @default(uuid()) @db.Uuid
  customerId    String             @db.Uuid
  vehicleId     String?
  hireVehicleId String?
  title         String
  status        CustomerCaseStatus @default(REQUESTED)
  details       String?
  /// Shipment tracking (imports/clearing): current stage key, public tracking code, expected arrival.
  kind          String             @default("general")
  stage         String?
  trackingCode  String?            @unique
  eta           DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  customer    CustomerUser         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle     Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  hireVehicle HireVehicle?         @relation(fields: [hireVehicleId], references: [id], onDelete: Restrict)
  updates     CustomerCaseUpdate[]
  purchases   Purchase[]

  @@index([customerId, updatedAt])
  @@index([status, updatedAt])
}

model CustomerCaseUpdate {
  id        String             @id @default(uuid()) @db.Uuid
  caseId    String             @db.Uuid
  status    CustomerCaseStatus
  message   String
  /// Shipment stage reached with this update, and photos (e.g. at the port).
  stage     String?
  photos    String[]           @default([])
  createdAt DateTime           @default(now())

  customerCase CustomerCase @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
}

model Account {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @unique @db.Uuid
  currency   String   @default("MWK")
  balance    Decimal  @default(0) @db.Decimal(19, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer           CustomerUser           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  transactions       FinancialTransaction[]
  paymentSubmissions PaymentSubmission[]

  @@index([customerId])
}

enum FinancialTransactionType {
  DEPOSIT
  WITHDRAWAL
}

model FinancialTransaction {
  id          String                   @id @default(uuid()) @db.Uuid
  accountId   String                   @db.Uuid
  type        FinancialTransactionType
  amount      Decimal                  @db.Decimal(19, 2)
  currency    String
  reference   String                   @unique
  description String?
  createdAt   DateTime                 @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([accountId, type, createdAt])
}

enum PaymentSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model PaymentSubmission {
  id                String                  @id @default(uuid()) @db.Uuid
  customerId        String                  @db.Uuid
  accountId         String                  @db.Uuid
  amount            Decimal                 @db.Decimal(19, 2)
  currency          String
  proofUrl          String
  reference         String                  @unique
  note              String?
  status            PaymentSubmissionStatus @default(PENDING)
  reviewNote        String?
  reviewedAt        DateTime?
  reviewedByAdminId String?
  /// The purchase this payment is for (optional): approving it pays that purchase instead of the balance.
  purchaseId        String?                 @db.Uuid
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  purchase        Purchase?    @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  customer        CustomerUser @relation(fields: [customerId], references: [id], onDelete: Restrict)
  account         Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  reviewedByAdmin AdminUser?   @relation(fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([accountId, createdAt])
  @@index([status, createdAt])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String
  oldValue    Json?
  newValue    Json?
  createdAt   DateTime @default(now())

  actor CustomerUser? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
}

/// Editable site text — contact details, social links, About page copy —
/// stored as one row per logical section rather than one row per field.
/// A section's shape is defined by frontend/backend TypeScript types, not
/// by the database; the JSON column just needs to fit whatever shape that
/// section currently has. See src/types/siteContent.ts on the frontend for
/// the exact shape of each key.
model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique // "contact" | "social" | "about" | "seo"
  value     Json
  updatedAt DateTime @updatedAt
}

// Vehicles for sale. Images/features kept as string arrays rather than a
// separate VehicleImage table — the brief's suggested entities are a menu,
// not a requirement, and normalizing photos into their own table isn't
// justified until an admin/CMS needs to manage them independently.
model Vehicle {
  id           String   @id @default(cuid())
  slug         String   @unique
  make         String
  model        String
  year         Int
  price        Int
  currency     String   @default("USD")
  mileageKm    Int
  fuelType     String
  transmission String
  bodyType     String
  engine       String
  driveType    String
  condition    String
  location     String
  status       String   @default("available") // available | reserved | sold
  description  String
  features     String[]
  images       String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inquiries     Inquiry[]
  customerCases CustomerCase[]
  savedBy       SavedVehicle[]
  reviews       Review[]
  viewStats     VehicleViewStat[]
  purchases     Purchase[]
  /// Hidden from the public site when false (a draft or temporarily off the market).
  isPublished   Boolean           @default(true)
  /// Set = archived: hidden everywhere public, kept so it can be restored or duplicated later.
  archivedAt    DateTime?
  /// Pinned first on the homepage carousel and listings.
  isFeatured    Boolean           @default(false)
}

/// A customer's shortlist while browsing — bookmark now, compare/decide
/// later. Cascade on delete in both directions: unlike CustomerCase (an
/// audit-worthy staff record), this is just a convenience list, so nothing
/// should be blocked from being deleted because someone saved it.
model SavedVehicle {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  vehicleId  String
  createdAt  DateTime @default(now())

  customer CustomerUser @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle  Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  /// Price the customer was last told about (or saw when saving), so a price
  /// drop is emailed once, not on every edit.
  notifiedPrice Int?

  @@unique([customerId, vehicleId])
  @@index([customerId, createdAt])
}

model HireVehicle {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  dailyRate    Int
  weeklyRate   Int?
  currency     String   @default("USD")
  transmission String
  fuelType     String
  seats        Int
  available    Boolean  @default(true)
  /// Cover photo (always shown first; kept for older data and simple lists).
  image        String
  /// Full gallery including the cover, in display order. Empty for vehicles
  /// created before galleries existed — readers fall back to [image].
  images       String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hireRequests  HireRequest[]
  customerCases CustomerCase[]
  isPublished   Boolean        @default(true)
  archivedAt    DateTime?
}

model Inquiry {
  id               String        @id @default(cuid())
  fullName         String
  phone            String
  email            String
  vehicleId        String?
  vehicle          Vehicle?      @relation(fields: [vehicleId], references: [id])
  message          String?
  /// "new" | "contacted" | "closed" — lets an admin mark that a submission
  /// has been followed up on, so nothing quietly falls through the cracks.
  status           String        @default("new")
  /// Set automatically when submitted by a logged-in customer (never
  /// user-supplied) so it shows up in their account portal — null for
  /// anonymous/visitor submissions, which remain fully supported.
  customerId       String?       @db.Uuid
  customer         CustomerUser? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  /// How the customer asked to be reached: whatsapp | call | email | message (their Lycie profile).
  preferredContact String?

  @@index([customerId, createdAt])
}

model ImportRequest {
  id                     String        @id @default(cuid())
  fullName               String
  phone                  String
  email                  String
  preferredMake          String
  preferredModel         String?
  preferredYear          Int?
  budget                 Int?
  fuelType               String?
  transmission           String?
  vehicleType            String?
  preferredSourceCountry String?
  additionalRequirements String?
  status                 String        @default("new")
  customerId             String?       @db.Uuid
  customer               CustomerUser? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt              DateTime      @default(now())
  /// How the customer asked to be reached: whatsapp | call | email | message (their Lycie profile).
  preferredContact       String?

  @@index([customerId, createdAt])
}

model ClearingRequest {
  id                    String        @id @default(cuid())
  fullName              String
  phone                 String
  email                 String
  vehicleMake           String
  vehicleModel          String?
  year                  Int?
  vin                   String
  currentLocation       String
  arrivalPortOrBorder   String?
  expectedArrivalDate   DateTime?
  availableDocuments    String?
  additionalInformation String?
  status                String        @default("new")
  customerId            String?       @db.Uuid
  customer              CustomerUser? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt             DateTime      @default(now())
  /// How the customer asked to be reached: whatsapp | call | email | message (their Lycie profile).
  preferredContact      String?

  @@index([customerId, createdAt])
}

model HireRequest {
  id                     String        @id @default(cuid())
  fullName               String
  phone                  String
  email                  String
  vehicleId              String
  vehicle                HireVehicle   @relation(fields: [vehicleId], references: [id])
  pickupDate             DateTime
  returnDate             DateTime
  pickupLocation         String
  additionalRequirements String?
  /// Computed server-side at submission time from the vehicle's rates —
  /// never accepted from the client, so a request can't be tampered with
  /// to claim a lower price. See src/hire-requests/hire-pricing.util.ts.
  days                   Int
  totalCost              Int
  currency               String        @default("USD")
  /// "pending" (just submitted, not yet reviewed) | "confirmed" (a real
  /// booking — this vehicle is committed for these dates) | "cancelled" |
  /// "completed" (vehicle actually confirmed returned by an admin — distinct
  /// from the return date merely passing, which is "overdue" until someone
  /// marks it returned). A request only counts as an actual booking once
  /// confirmed — see HireRequestsService.updateStatus(), which also checks
  /// for overlapping confirmed bookings on the same vehicle before allowing
  /// confirmation.
  status                 String        @default("pending")
  /// Prevents the daily reminder job from re-sending the same "due
  /// tomorrow" / "overdue" email every single day once triggered once.
  dueReminderSentAt      DateTime?
  overdueReminderSentAt  DateTime?
  customerId             String?       @db.Uuid
  customer               CustomerUser? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt              DateTime      @default(now())
  /// How the customer asked to be reached: whatsapp | call | email | message (their Lycie profile).
  preferredContact       String?

  @@index([customerId, createdAt])
}

model ContactMessage {
  id               String        @id @default(cuid())
  fullName         String
  email            String
  phone            String?
  subject          String
  message          String
  status           String        @default("new")
  customerId       String?       @db.Uuid
  customer         CustomerUser? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  /// How the customer asked to be reached: whatsapp | call | email | message (their Lycie profile).
  preferredContact String?

  @@index([customerId, createdAt])
}

/// Site-wide announcements — banners at the top of every page, or popups
/// shown once per browser session. Color is derived from `type` on the
/// frontend (info/warning/success/promo), not stored directly, so the
/// palette stays centralized in one place (src/types/notice.ts) rather than
/// admins picking arbitrary hex values per notice.
model Notice {
  id         String    @id @default(cuid())
  title      String?
  message    String
  type       String    @default("info") // "info" | "warning" | "success" | "promo"
  displayAs  String    @default("banner") // "banner" | "popup"
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
}

// Marketing content — testimonials, FAQ, and the blog — managed the same
// way as Notice/SiteContent (admin dashboard CRUD, public read endpoints).
// These were originally scoped to a separate Strapi CMS, but Strapi 5
// currently fails to boot under Node 20+ (see server/README.md's
// "CMS content" section) — an unresolved upstream bug, not something wrong
// with this app — so they live here instead, in the same database and admin
// dashboard as everything else.
model Testimonial {
  id             String    @id @default(cuid())
  quote          String
  authorName     String
  authorTitle    String?
  authorPhotoUrl String?
  rating         Int       @default(5) // 1-5
  isFeatured     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  isPublished    Boolean   @default(true)
  archivedAt     DateTime?
}

model Faq {
  id          String    @id @default(cuid())
  question    String
  answer      String
  category    String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isPublished Boolean   @default(true)
  archivedAt  DateTime?
}

model BlogPost {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  excerpt        String?
  body           String
  coverImageUrl  String?
  coverAlt       String?
  seoTitle       String?
  seoDescription String?
  /// Null = draft, not shown on the public /blog list or detail page.
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?
}

/// A visitor's or customer's rating + comment, either about a specific
/// vehicle or (vehicleId null) about the company. Nothing is shown publicly
/// until an admin approves it. Sentiment is computed once at submission
/// (see src/insights/sentiment.util.ts — an offline lexicon, no external
/// API) so the admin can spot unhappy customers at a glance without
/// re-analysing text on every page load.
model Review {
  id             String        @id @default(cuid())
  authorName     String
  rating         Int
  comment        String
  vehicleId      String?
  vehicle        Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  /// Set automatically for logged-in customers (never user-supplied).
  customerId     String?       @db.Uuid
  customer       CustomerUser? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// "pending" | "approved" | "rejected"
  status         String        @default("pending")
  /// "positive" | "neutral" | "negative"
  sentiment      String
  /// -1 (very negative) .. 1 (very positive), blending rating and text.
  sentimentScore Float
  keywords       String[]
  createdAt      DateTime      @default(now())

  @@index([status, createdAt])
  @@index([vehicleId, status])
}

/// Anonymous, aggregated-per-day page-view counter for a vehicle. Stores no
/// IP, cookie or user identifier — only "vehicle X was viewed N times on
/// day D" — which is all the demand insights need and keeps this
/// privacy-light by construction.
model VehicleViewStat {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  views     Int      @default(0)

  @@unique([vehicleId, day])
  @@index([day])
}

/// A piece of company knowledge an admin/manager has fed to the Lycie
/// assistant — FAQs, policies, process notes, pricing guidance. Lycie
/// answers from these (plus live inventory and site content) rather than
/// guessing. Searched with Postgres full-text search (see the migration that
/// adds the GIN index), so nothing is sent to an external service to index it.
model KnowledgeEntry {
  id         String             @id @default(cuid())
  title      String
  /// Free-form grouping for the admin list: faq | policy | process | pricing | other
  category   String             @default("faq")
  content    String
  isActive   Boolean            @default(true)
  /// Set when this entry is one section of an uploaded file (see KnowledgeDocument).
  documentId String?
  document   KnowledgeDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([isActive, category])
  @@index([documentId])
}

/// A file an admin uploaded for Lycie to learn from (PDF, Word, text, image…).
/// Its text is split into KnowledgeEntry sections; deleting the document
/// removes them all, pausing it pauses them all.
model KnowledgeDocument {
  id        String   @id @default(cuid())
  fileName  String
  mimeType  String
  sizeBytes Int
  charCount Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  entries KnowledgeEntry[]
}

/// One question/answer exchange with Lycie, kept so admins can see what
/// customers actually ask and where Lycie fell short. Personal details are
/// stripped BEFORE anything is stored (see lycie/pii.util.ts), no user or
/// session identifier is recorded, and rows are purged after a retention
/// period. Learning is deliberately human-in-the-loop: admins turn recurring
/// gaps into knowledge entries; the model is never trained on raw chats.
model LycieChatLog {
  id        String   @id @default(cuid())
  question  String
  answer    String
  /// Which model actually produced the answer (null if none could).
  model     String?
  /// "answered" | "no_info" (Lycie said it lacked the information) |
  /// "unavailable" (every model failed / quota) | "blocked" (over a limit)
  outcome   String
  /// Customer's thumbs up/down, if they gave one.
  helpful   Boolean?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([outcome, createdAt])
}

/// A question or comment a visitor typed into the "Ask us" form on the FAQ
/// page. Personal details are redacted before saving. Questions feed Lycie's
/// FAQ analysis alongside chat questions; comments are read by staff.
model VisitorSubmission {
  id             String   @id @default(cuid())
  kind           String // question | comment
  message        String
  sentiment      String? // comments only: positive | neutral | negative
  sentimentScore Float?
  status         String   @default("new") // new | handled
  createdAt      DateTime @default(now())

  @@index([kind, status, createdAt])
}

/// A draft FAQ entry written by Lycie after noticing a topic asked about
/// repeatedly. Drafts are NEVER shown to customers until an admin publishes
/// them (which creates a normal Faq row).
model FaqSuggestion {
  id             String   @id @default(cuid())
  question       String
  answer         String
  category       String?
  askCount       Int      @default(1)
  samples        String[] // a few (redacted) example questions behind the draft
  /// The company data didn't cover this topic — the answer is a placeholder an admin must complete.
  needsInput     Boolean  @default(false)
  status         String   @default("pending") // pending | published | rejected
  model          String?
  publishedFaqId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, askCount])
}

/// A visitor's "like" on a vehicle, hire vehicle or blog post — no account
/// needed. `visitorId` is a random id the visitor's own browser generated and
/// keeps in localStorage: it lets one browser like something once and undo it,
/// and identifies no one. (It is not a security control — someone determined
/// could mint many ids — so counts are a popularity signal, not a vote.)
model ContentLike {
  id        String   @id @default(cuid())
  kind      String // vehicle | hire | blog
  targetId  String
  visitorId String
  createdAt DateTime @default(now())

  @@unique([kind, targetId, visitorId])
  @@index([kind, targetId])
}

/// A record that staff got in touch about a request (or tried to), so the whole
/// team can see who contacted the customer, how, and when.
model ContactLog {
  id          String   @id @default(cuid())
  requestType String // inquiry | import | clearing | hire | contact
  requestId   String
  method      String // whatsapp | call | email | message
  note        String?
  adminName   String
  createdAt   DateTime @default(now())

  @@index([requestType, requestId])
}

/// A message from staff to a customer, shown inside their Lycie profile
/// (account page). Only customers who submitted while signed in can receive one.
model CustomerMessage {
  id          String       @id @default(cuid())
  customerId  String       @db.Uuid
  customer    CustomerUser @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subject     String
  body        String
  requestType String?
  requestId   String?
  sentByName  String
  readAt      DateTime?
  createdAt   DateTime     @default(now())

  @@index([customerId, createdAt])
}

/// A positive customer comment or review that Lycie spotted and proposes as a
/// homepage testimonial. Quotes are always the customer's own words — never
/// rewritten — and nothing is published until an admin approves it.
model TestimonialIdea {
  id         String   @id @default(cuid())
  source     String // review | comment
  sourceId   String
  quote      String
  authorName String
  rating     Int?
  /// 0-1: how positive and substantial it is (used to rank ideas).
  score      Float
  status     String   @default("pending") // pending | published | dismissed
  createdAt  DateTime @default(now())

  @@unique([source, sourceId])
  @@index([status, score])
}

/// Who changed what in the admin, and when — for accountability when several
/// people manage the site. Records the action and target, never the content
/// that was submitted (which may hold customers' personal details).
model AdminActivity {
  id        String   @id @default(cuid())
  adminId   String
  adminName String
  role      String
  action    String // human-readable, e.g. "Archived 3 vehicles"
  route     String // e.g. "POST /content-admin/:type/bulk"
  targetId  String?
  createdAt DateTime @default(now())

  /// True when the database changes this action made were captured, so it can be undone.
  undoable Boolean   @default(false)
  undoneAt DateTime?
  undoneBy String?
  /// Set on the entry recorded BY an undo: the action it reversed.
  undoOfId String?

  changes ChangeRecord[]

  @@index([createdAt])
  @@index([adminId, createdAt])
}

/// A promotion or bargain found for vehicles (by the AI deals finder, or added by hand).
/// ADMIN-ONLY details (`howToGet`, `sources`) are never returned by any public endpoint —
/// visitors only ever see title, summary, price and validity of PUBLISHED deals.
model Deal {
  id           String     @id @default(cuid())
  title        String
  /// Customer-facing wording. Written without company names or web addresses.
  summary      String
  /// Headline price in US dollars, if the deal has one.
  priceUsd     Int?
  vehicleLabel String?
  validUntil   DateTime?
  /// For staff only: who to contact and the steps to actually get this deal.
  howToGet     String     @default("")
  /// For staff only: the web pages the deal was found on. Never shown publicly.
  sources      String[]   @default([])
  status       DealStatus @default(NEW)
  /// "ai" = found by the deals finder; "manual" = typed in by staff.
  origin       String     @default("ai")
  publishedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  purchases    Purchase[]

  @@index([status, createdAt])
}

enum DealStatus {
  NEW
  PUBLISHED
  DISMISSED
}

/// One AI-generated market briefing (what is selling, what to do about it). Latest is shown in the admin.
model MarketReport {
  id        String   @id @default(cuid())
  content   Json
  /// Web pages the briefing drew on — admin reference only.
  sources   String[] @default([])
  createdAt DateTime @default(now())
}

/// A post written in the admin to be sent to the company's social pages (now or scheduled).
model SocialPost {
  id           String    @id @default(cuid())
  message      String
  imageUrl     String?
  linkUrl      String?
  /// Which pages to send it to: "facebook", "instagram".
  channels     String[]  @default([])
  /// DRAFT, SCHEDULED, PUBLISHED, PARTIAL (some pages failed) or FAILED.
  status       String    @default("DRAFT")
  /// Per page: { ok, id, error }.
  results      Json?
  scheduledFor DateTime?
  publishedAt  DateTime?
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, scheduledFor])
}

/// One row changed by an admin action: its state before and after, so the
/// action can be reversed (see server/src/undo/). Server-side only — never
/// returned by the API, because rows can hold customer details and hashes.
model ChangeRecord {
  id         String        @id @default(cuid())
  activityId String
  activity   AdminActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  /// Order the change happened in within the action.
  seq        Int
  /// Prisma model name, e.g. "Vehicle".
  model      String
  recordId   String
  /// Null = the row did not exist before (it was created).
  before     Json?
  /// Null = the row no longer exists after (it was deleted).
  after      Json?
  createdAt  DateTime      @default(now())

  @@index([activityId, seq])
}

/// A signed-out session. Sessions are signed tokens that stay valid until
/// they expire, so signing out records the token's id here until then.
model RevokedSession {
  jti       String   @id
  expiresAt DateTime

  @@index([expiresAt])
}

/// "Email me when a matching vehicle is listed." Saved by signed-in customers
/// with a confirmed email address; checked whenever a vehicle is published.
model VehicleAlert {
  id             String       @id @default(cuid())
  customerId     String       @db.Uuid
  customer       CustomerUser @relation(fields: [customerId], references: [id], onDelete: Cascade)
  make           String?
  model          String?
  bodyType       String?
  /// Upper price limit in the vehicle's stored currency units (USD by default).
  maxPrice       Int?
  minYear        Int?
  isActive       Boolean      @default(true)
  lastSentAt     DateTime?
  /// Vehicles already emailed for this alert, so each is announced once.
  sentVehicleIds String[]     @default([])
  createdAt      DateTime     @default(now())

  @@index([customerId])
  @@index([isActive])
}

/// A staff member's request for time off (HR module).
model LeaveRequest {
  id           String    @id @default(cuid())
  employeeId   String
  employee     AdminUser @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// annual | sick | family | unpaid | other
  type         String
  startDate    DateTime  @db.Date
  endDate      DateTime  @db.Date
  days         Int
  reason       String    @default("")
  /// pending | approved | declined | cancelled
  status       String    @default("pending")
  reviewedById String?
  reviewedBy   String?
  reviewNote   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([employeeId, startDate])
  @@index([status, startDate])
}

/// A mobile-money payment (Airtel Money / TNM Mpamba) made through the payment gateway (PayChangu).
model MobilePayment {
  id           String        @id @default(cuid())
  customerId   String?       @db.Uuid
  customer     CustomerUser? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Our reference, sent to the gateway and used to verify the payment.
  txRef        String        @unique
  amount       Int
  currency     String        @default("MWK")
  /// deposit | hire | import | clearing | other
  purpose      String        @default("deposit")
  note         String        @default("")
  /// pending | success | failed
  status       String        @default("pending")
  provider     String        @default("paychangu")
  checkoutUrl  String?
  /// The gateway's answer when verified (method, network, charges). Admin reference only.
  providerData Json?
  /// Paying toward a purchase: the payment goes to it (converted at `exchangeRate`, fixed when the customer started) instead of the balance.
  purchaseId   String?       @db.Uuid
  purchase     Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  exchangeRate Decimal?      @db.Decimal(19, 6)
  confirmedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

/// One customer inviting another. Rewarded by staff once the new customer does business.
model Referral {
  id           String       @id @default(cuid())
  referrerId   String       @db.Uuid
  referrer     CustomerUser @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId   String       @unique @db.Uuid
  referred     CustomerUser @relation("ReferredCustomer", fields: [referredId], references: [id], onDelete: Cascade)
  /// pending | rewarded | declined
  status       String       @default("pending")
  rewardAmount Int?
  rewardNote   String?
  rewardedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([referrerId])
  @@index([status, createdAt])
}

/// A system administrator's edit of a workspace guide (the "About this page"
/// descriptions staff see). Guides not edited use the built-in text in
/// server/src/guides/guide-defaults.ts.
model WorkspaceGuide {
  /// "module:<key>" or "page:<path>", e.g. "page:/admin/vehicles".
  key         String   @id
  title       String
  body        String
  /// Who sees it: "module" (anyone who can open that module/page), "admins"
  /// (system administrators only), "departments" (the listed ones), "hidden".
  audience    String   @default("module")
  departments String[] @default([])
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

/// Something a customer bought from us — a vehicle, an import, clearing, a hire,
/// parts or a service — with what each part cost, any deal/promotion/discount,
/// what has been paid and what is still owed. Balance = total - amountPaid.
model Purchase {
  id             String        @id @default(uuid()) @db.Uuid
  /// Shown on receipts and statements, e.g. "PUR-2026-0042".
  reference      String        @unique
  customerId     String        @db.Uuid
  customer       CustomerUser  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// vehicle | import | clearing | hire | parts | service | other
  type           String
  title          String
  currency       String        @default("USD")
  /// Sum of the cost items, before any discount.
  subtotal       Decimal       @db.Decimal(19, 2)
  /// standard | deal | promotion | discount
  pricing        String        @default("standard")
  /// The deal or promotion's name, or why a discount was given.
  offerName      String?
  promoCode      String?
  dealId         String?
  deal           Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  discountAmount Decimal       @default(0) @db.Decimal(19, 2)
  /// What the customer owes in total: subtotal - discountAmount.
  total          Decimal       @db.Decimal(19, 2)
  /// Money received minus refunds (voided payments excluded). Changed only in the
  /// same database transaction as the PurchasePayment rows it sums.
  amountPaid     Decimal       @default(0) @db.Decimal(19, 2)
  /// active | cancelled
  status         String        @default("active")
  purchasedAt    DateTime      @default(now())
  dueDate        DateTime?
  vehicleId      String?
  vehicle        Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  /// The shipment (import/clearing) this purchase pays for.
  caseId         String?       @db.Uuid
  shipment       CustomerCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  /// Request it came from: "hire-request" | "import-request" | "clearing-request" | "inquiry", and its id.
  sourceType     String?
  sourceId       String?
  /// Seen by the customer.
  customerNote   String?
  /// Staff only.
  staffNote      String?
  createdById    String?
  createdByName  String?
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items              PurchaseItem[]
  payments           PurchasePayment[]
  paymentSubmissions PaymentSubmission[]
  mobilePayments     MobilePayment[]

  @@index([customerId, purchasedAt])
  @@index([status, purchasedAt])
  @@index([type, purchasedAt])
  @@index([pricing, purchasedAt])
}

/// One cost line of a purchase (the vehicle, shipping, duty, clearing fees…).
model PurchaseItem {
  id          String   @id @default(uuid()) @db.Uuid
  purchaseId  String   @db.Uuid
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  /// vehicle | shipping | duty | clearing | registration | hire | insurance | parts | service | fee | other
  category    String
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(19, 2)
  /// quantity × unitPrice
  amount      Decimal  @db.Decimal(19, 2)
  sortOrder   Int      @default(0)

  @@index([purchaseId, sortOrder])
}

/// Money received for a purchase (or refunded). Never deleted: a mistake is
/// voided (with a reason), so the history stays complete.
model PurchasePayment {
  id               String    @id @default(uuid()) @db.Uuid
  purchaseId       String    @db.Uuid
  purchase         Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  /// payment | refund
  kind             String    @default("payment")
  /// In the purchase's currency, always positive.
  amount           Decimal   @db.Decimal(19, 2)
  /// cash | bank | mobile_money | card | cheque | account_balance | other
  method           String
  /// Receipt number, bank or mobile-money reference.
  reference        String?
  /// When the money actually came in (may be earlier than when it was recorded).
  paidAt           DateTime  @default(now())
  note             String?
  /// When the customer paid in another currency: what they handed over, and the rate used (units per 1 of the purchase currency).
  receivedAmount   Decimal?  @db.Decimal(19, 2)
  receivedCurrency String?
  exchangeRate     Decimal?  @db.Decimal(19, 6)
  /// staff | mobile_money | payment_proof | account_balance
  source           String    @default("staff")
  /// The mobile-money txRef / proof reference / ledger reference, so nothing is counted twice.
  sourceRef        String?   @unique
  recordedById     String?
  recordedByName   String?
  voidedAt         DateTime?
  voidReason       String?
  voidedByName     String?
  createdAt        DateTime  @default(now())

  @@index([purchaseId, paidAt])
  @@index([paidAt])
}
