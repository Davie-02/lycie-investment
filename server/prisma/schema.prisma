generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  OWNER   // full access, including managing other admin accounts
  MANAGER // vehicles, hire vehicles, site content, requests — not user management
  VIEWER  // read-only on submitted requests
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(MANAGER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Vehicles for sale. Images/features kept as string arrays rather than a
// separate VehicleImage table — the brief's suggested entities are a menu,
// not a requirement, and normalizing photos into their own table isn't
// justified until an admin/CMS needs to manage them independently.
model Vehicle {
  id          String   @id @default(cuid())
  slug        String   @unique
  make        String
  model       String
  year        Int
  price       Int
  currency    String   @default("MWK")
  mileageKm   Int
  fuelType    String
  transmission String
  bodyType    String
  engine      String
  driveType   String
  condition   String
  location    String
  status      String   @default("available") // available | reserved | sold
  description String
  features    String[]
  images      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inquiries Inquiry[]
}

model HireVehicle {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  dailyRate    Int
  weeklyRate   Int?
  currency     String   @default("MWK")
  transmission String
  fuelType     String
  seats        Int
  available    Boolean  @default(true)
  image        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hireRequests HireRequest[]
}

model Inquiry {
  id        String   @id @default(cuid())
  fullName  String
  phone     String
  email     String
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  message   String?
  createdAt DateTime @default(now())
}

model ImportRequest {
  id                     String   @id @default(cuid())
  fullName               String
  phone                  String
  email                  String
  preferredMake          String
  preferredModel         String?
  preferredYear          Int?
  budget                 Int?
  fuelType               String?
  transmission           String?
  vehicleType            String?
  preferredSourceCountry String?
  additionalRequirements String?
  createdAt              DateTime @default(now())
}

model ClearingRequest {
  id                     String    @id @default(cuid())
  fullName               String
  phone                  String
  email                  String
  vehicleMake            String
  vehicleModel           String?
  year                   Int?
  vin                    String
  currentLocation        String
  arrivalPortOrBorder    String?
  expectedArrivalDate    DateTime?
  availableDocuments     String?
  additionalInformation  String?
  createdAt              DateTime  @default(now())
}

model HireRequest {
  id                     String      @id @default(cuid())
  fullName               String
  phone                  String
  email                  String
  vehicleId              String
  vehicle                HireVehicle @relation(fields: [vehicleId], references: [id])
  pickupDate             DateTime
  returnDate             DateTime
  pickupLocation         String
  additionalRequirements String?
  createdAt              DateTime    @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  phone     String?
  subject   String
  message   String
  createdAt DateTime @default(now())
}
