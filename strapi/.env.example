# Strapi CMS — Environment Variables
# Copy this file to .env and fill in your values

# NOTE: Strapi uses its own database separate from the NestJS API.
# Do not share DATABASE_URL with the server/.env.

# Application
APP_NAME=lycie-strapi
HOST=0.0.0.0
PORT=1337
ADMIN_URL=/admin
APP_KEYS=lycie-strapi-app-key-change-in-production

# Database (Strapi uses its own database — do not share with NestJS/Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/lycie_strapi?schema=public

# Admin Security (change these in production!)
ADMIN_AUTH_SECRET=lycie-admin-auth-secret-change-in-production
API_TOKEN_SALT=lycie-api-token-salt
TRANSFER_TOKEN_SALT=lycie-transfer-token-salt
ADMIN_ENCRYPTION_KEY=lycie-admin-encryption-key-change-in-production

# Strapi Admin
STRAPI_ADMIN_UPLOAD_PATH=public/uploads
STRAPI_MOUNT_ADMIN=/

# if using S3 for uploads in production
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=
# S3_PUBLIC_URL_BASE=
