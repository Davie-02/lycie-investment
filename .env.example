# Base URL of the Lycie Investment API (see the server/ folder).
# Defaults to http://localhost:3001/api if not set.
VITE_API_BASE_URL=http://localhost:3001/api

# Base URL of the Strapi CMS API (see the strapi/ folder).
# Set this if you're using Strapi as the content source instead of the NestJS API.
# Leave commented out to use the NestJS API by default.
# VITE_STRAPI_API_URL=http://localhost:1337/api

# Set to 'true' to use Strapi as the content source instead of NestJS.
# When enabled, vehicles, hire vehicles, site content, and notices come from Strapi.
# Auth, forms, and financial APIs still use the NestJS backend.
# VITE_USE_STRAPI_API=false
