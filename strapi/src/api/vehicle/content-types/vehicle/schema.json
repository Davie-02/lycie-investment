{
  "kind": "collectionType",
  "collectionName": "vehicles_v1",
  "info": {
    "displayName": "Vehicle",
    "singularName": "vehicle",
    "pluralName": "vehicles"
  },
  "attributes": {
    "title": { "type": "string", "required": true, "unique": true },
    "slug": { "type": "uid", "targetField": "title", "required": true, "unique": true },
    "year": { "type": "integer", "required": true },
    "make": { "type": "string", "required": true },
    "model": { "type": "string", "required": true },
    "transmission": {
      "type": "enumeration",
      "enum": ["manual", "automatic"],
      "required": true
    },
    "fuel": {
      "type": "enumeration",
      "enum": ["petrol", "diesel", "hybrid", "electric", "lpg"],
      "required": true
    },
    "bodyType": { "type": "string" },
    "description": { "type": "text" },
    "location": { "type": "string" },
    "price": { "type": "integer", "required": true },
    "currency": { "type": "string", "default": "ZMW", "required": true },
    "mileage": { "type": "integer" },
    "engine": { "type": "string" },
    "vin": { "type": "string" },
    "coDriver": { "type": "string" },
    "condition": { "type": "string" },
    "origin": { "type": "string" },
    "yearFacsimile": { "type": "boolean" },
    "features": { "type": "json" },
    "externalLinks": { "type": "json" },
    "imageUrl": { "type": "string" },
    "imageCaption": { "type": "string" },
    "imageAlt": { "type": "string" },
    "vehicleImage": { "type": "media", "multiple": false },
    "galleryImage": { "type": "media", "multiple": true },
    "featured": { "type": "boolean", "default": false }
  }
}
