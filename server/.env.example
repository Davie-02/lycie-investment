# Lycie Investments API — environment variables
# Copy this file to .env and fill in your values.

# --- Core ---
DATABASE_URL=postgresql://lycie:lycie@localhost:5432/lycie_investment?schema=public
PORT=3001
NODE_ENV=development

# URL of the deployed frontend — CORS only allows requests from this origin.
# Defaults to http://localhost:5173 in development.
FRONTEND_URL=http://localhost:5173

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
# Optional, defaults to a sane value if unset — see auth.module.ts.
# How long a normal sign-in lasts (default 2h). "Keep me signed in" uses
# REMEMBER_ME_EXPIRES_IN instead (default 30d). Formats: 30m, 2h, 7d.
# JWT_EXPIRES_IN=2h
# REMEMBER_ME_EXPIRES_IN=30d
# Cookie SameSite override: "none" (default in production, needed when the site
# and API are on different domains), or "lax"/"strict" when the site is served
# through the same domain as the API (see DEPLOYMENT.md, "Same-domain setup").
# COOKIE_SAMESITE=none

# --- Sign in with Google / Facebook (optional; buttons stay hidden until set) ---
# Google: Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (type "Web application"); add your site URL under "Authorised JavaScript origins".
# GOOGLE_CLIENT_ID=
# Facebook: developers.facebook.com -> your app -> Facebook Login. Keep the secret private.
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# --- First-run admin seed (used by prisma/seed.ts) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
# A bcrypt hash, not a plaintext password — see server/README.md "First-time setup".
ADMIN_PASSWORD_HASH=

# --- Image uploads ---
# Leave S3_BUCKET unset to store uploads on local disk (fine for development,
# not durable across deploys on most hosts — set S3_* in production).
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL_BASE=
# Set true to keep the bucket PRIVATE and serve images through the API at
# /api/media/<file> (no public bucket needed; leave S3_PUBLIC_URL_BASE unset).
# S3_PRIVATE_BUCKET=true

# --- Email notifications (optional — sending is skipped and logged if unset) ---
# Pick ONE provider (both are plain HTTPS APIs, which work on free hosting that
# blocks SMTP). Set EMAIL_PROVIDER=resend|brevo, or just set one key.
#  - Resend (resend.com): to email real customers you must verify a domain you own.
#  - Brevo (brevo.com, free 300/day): can send from one verified address (no domain needed).
# RESEND_API_KEY=
# BREVO_API_KEY=
# EMAIL_PROVIDER=
# Sender shown to customers. Must be verified with the provider.
# EMAIL_FROM="Lycie Investments <info@yourdomain.com>"
# Where customers' replies go (e.g. the company inbox).
# EMAIL_REPLY_TO=
# ADMIN_NOTIFICATION_EMAIL=

# --- Reverse proxy ---
# Number of proxy hops in front of the API (usually 1 on Render/Railway/Fly/
# Nginx). Needed so rate limits apply per visitor, not per proxy. Leave unset
# if the API is exposed directly to the internet.
# TRUST_PROXY=1

# --- Lycie AI assistant (Google Gemini, free tier) ---
# Get a free key at https://aistudio.google.com/apikey. Without it the chat
# widget hides itself and the rest of the site works normally.
# GEMINI_API_KEY=
# Models tried in order; if one is over quota or overloaded the next is used.
# LYCIE_CHAT_MODELS=gemini-3.8-flash,gemini-3.1-flash-lite,gemini-3.5-flash
# 0 = no extra "thinking" (faster). Raise for more careful, slower answers.
# LYCIE_THINKING_BUDGET=0
# Global cap on AI answers per day, protecting the free quota (default 300).
# LYCIE_DAILY_LIMIT=300
# Per-visitor cap on questions per hour (default 40).
# LYCIE_HOURLY_LIMIT_PER_IP=40
# How many characters of admin knowledge go into each prompt (default 12000).
# LYCIE_KNOWLEDGE_CHARS=12000
# Days chat logs are kept before automatic deletion (default 90).
# LYCIE_LOG_RETENTION_DAYS=90
# Minimum times a question must be asked before Lycie drafts an FAQ entry for it (default 2).
# LYCIE_SUGGEST_MIN_ASKS=2
# Weekly Monday-morning FAQ analysis (uses up to 5 AI calls). Set false to run it only from the admin button.
# LYCIE_AUTO_SUGGEST=true

# --- Social media posting and replying from the admin (optional) ---
# Connects a Facebook Page (and the Instagram business account linked to it) through Meta's Graph API.
# See DEPLOYMENT.md -> "Social media" for how to get these. Without them the tools show "not connected".
# META_PAGE_ID=
# META_PAGE_ACCESS_TOKEN=
# META_INSTAGRAM_ID=

# --- Deals finder / market briefing (admin only, need GEMINI_API_KEY) ---
# Searches per day the AI deals finder may run (default 6), and the automatic Monday-morning search.
# DEALS_DAILY_SCANS=6
# DEALS_AUTO_SCAN=true

# --- Search engines / social previews ---
# The website's public address, used for the sitemap, share cards and social posts (defaults to FRONTEND_URL).
# SITE_URL=https://your-site.example
