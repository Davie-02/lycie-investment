# Lycie Investment API — environment variables
# Copy this file to .env and fill in your values.

# --- Core ---
DATABASE_URL=postgresql://lycie:lycie@localhost:5432/lycie_investment?schema=public
PORT=3001
NODE_ENV=development

# URL of the deployed frontend — CORS only allows requests from this origin.
# Defaults to http://localhost:5173 in development.
FRONTEND_URL=http://localhost:5173

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
# Optional, defaults to a sane value if unset — see auth.module.ts.
# JWT_EXPIRES_IN=1d

# --- First-run admin seed (used by prisma/seed.ts) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
# A bcrypt hash, not a plaintext password — see server/README.md "First-time setup".
ADMIN_PASSWORD_HASH=

# --- Image uploads ---
# Leave S3_BUCKET unset to store uploads on local disk (fine for development,
# not durable across deploys on most hosts — set S3_* in production).
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL_BASE=

# --- Email notifications (optional — sending is skipped and logged if unset) ---
# RESEND_API_KEY=
# EMAIL_FROM=
# ADMIN_NOTIFICATION_EMAIL=
